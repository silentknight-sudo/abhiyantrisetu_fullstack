NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://setu:setu@localhost:5432/setu_dev
REDIS_URL=redis://localhost:6379

# 32+ random bytes each, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
OTP_HASH_SECRET=change-me-otp-hash-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# SMS: "console" logs OTPs (dev/test only), "msg91" sends real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
