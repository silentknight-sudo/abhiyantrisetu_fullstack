{
  "name": "@setu/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:partner": "APP_VARIANT=partner expo start --clear",
    "web": "expo start --web",
    "export:web": "expo export --platform web --clear --output-dir dist/customer && APP_VARIANT=partner expo export --platform web --clear --output-dir dist/partner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@setu/api-client": "workspace:*",
    "@setu/domain": "workspace:*",
    "@setu/schemas": "workspace:*",
    "@setu/ui-tokens": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.17",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.9",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "5.9.3"
  }
}
