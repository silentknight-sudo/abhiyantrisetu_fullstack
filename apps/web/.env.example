# Public base URL of the NestJS API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pre-launch: leave unset (or false) to show "Coming soon" for the apps, posting, Setu AI
# and partner sign-up. Set to true on launch day.
NEXT_PUBLIC_LAUNCHED=false

# Optional product analytics (PostHog). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
