{
  "name": "abhiyantri-setu",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "pnpm --filter @setu/api db:migrate",
    "db:generate": "pnpm --filter @setu/api db:generate",
    "db:seed": "pnpm --filter @setu/api db:seed",
    "api-client:generate": "pnpm --filter @setu/api openapi && pnpm --filter @setu/api-client generate"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.3"
  }
}
